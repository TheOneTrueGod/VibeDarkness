# Loaded only by the Vite dev server (`npm run dev` / `vite`), never by `vite build` (prod deploy).
# Local overrides go in .env.development.local (gitignored by Vite's *.local convention).

# --- Audio ---
# Start with game audio muted when the player has no saved music setting. Unset / false in prod.
VITE_AUDIO_MUTED_BY_DEFAULT=true
