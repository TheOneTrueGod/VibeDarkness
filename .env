# --- Lobby log (browser → POST /api/lobbies/<id>/lobby-log) ---
# Floor: only lines with severity >= this are sent. Lower name = more verbose / noisier.
# Order (most → least noisy): log, info, warn, error, critical. Use `off` to disable.
# Unset VITE_LOBBY_LOG_THRESHOLD → off (no client lobby_log from this path).
# VITE_LOBBY_LOG_THRESHOLD=off

# --- Battle sync (separate floor; does not use VITE_LOBBY_LOG_THRESHOLD) ---
# Same token order. Unset → info (second most noisy after log).
# Legacy: true / 1 → floor log (most noisy).
VITE_LOBBY_LOG_BATTLE_SYNC=info

# PHP server: same semantics for order-append lobby_log lines (AppendOrderHandler).
# Unset → info. Set in the shell, php.ini, or your process manager (Vite env is not visible to PHP).
LOBBY_LOG_BATTLE_SYNC=info
