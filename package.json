{
  "name": "multiplayer-lobby",
  "version": "1.4.8",
  "description": "Multiplayer game lobby - frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "vite",
    "build": "vite build",
    "deploy": "node scripts/deploy.js",
    "preview": "vite preview",
    "php": "nodemon --watch backend --watch index.php --ext php --exec \"php -S localhost:8000 index.php\"",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.js",
    "typecheck": "tsc --noEmit",
    "ci": "node scripts/ci.js",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "desyncDebug-getTick": "node scripts/desyncDebug-getTick.js",
    "desyncDebug-getFingerprints": "node scripts/desyncDebug-getFingerprints.js",
    "desyncDebug-getLobbyLog": "node scripts/desyncDebug-getLobbyLog.js",
    "desyncDebug-diffTick": "node scripts/desyncDebug-diffTick.js",
    "desyncDebug-getOrders": "node scripts/desyncDebug-getOrders.js",
    "desyncDebug-getCombatEvents": "node scripts/desyncDebug-getCombatEvents.js",
    "desyncDebug-desyncs": "node scripts/desyncDebug-desyncs.js",
    "desyncDebug-diffSnapshot": "node scripts/desyncDebug-diffSnapshot.js",
    "terrain-backup": "node scripts/terrain-backup.js",
    "terrain-restore": "node scripts/terrain-restore.js"
  },
  "dependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "lucide-react": "^1.8.0",
    "pixi.js": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^2.15.4",
    "ssh2": "^1.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.2.0",
    "vitest": "^2.1.0"
  }
}
