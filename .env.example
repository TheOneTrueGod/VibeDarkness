# --- PHP server environment ---
# Set to `development` on the local PHP server to enable dev-only debug endpoints
# (e.g. GET /api/lobbies/<id>/user-state/...) and open /lobby_debug without a token.
# APP_ENV=development

# --- Production lobby debug API (/lobby_debug/*) ---
# When set on the production server, agents may pass this value in the
# X-Lobby-Debug-Token header. Admins with a session cookie may also call the API.
# LOBBY_DEBUG_TOKEN=

# --- Lobby log (browser → POST /api/lobbies/<id>/lobby-log) ---
# Floor: only lines with severity >= this are sent. Lower name = more verbose / noisier.
# Order (most → least noisy): log, info, warn, error, critical. Use `off` to disable.
# Unset VITE_LOBBY_LOG_THRESHOLD → off (no client lobby_log from this path).
# VITE_LOBBY_LOG_THRESHOLD=off

# --- Battle sync floor ---
# Configure in global_constants.js (client) and global_constants.php (PHP); not via .env.

# --- Battle heartbeat trace (console) ---
# When set, logs every GET …/heartbeat with scheduling/throttle context (`console.info`). Restart Vite after change.
# Alternatively: Debug Console → Debug logging → Battle heartbeat → Log (no restart; uses debugLog).
# VITE_BATTLE_HEARTBEAT_TRACE=1
